# The admin app zip is the shipped artifact. The extracted directory is
# a work tree containing keys, .env, and node_modules — never commit it.
pinkfish-connections-admin-app-main/

# Binary artifacts — distributed out of band (Drive / S3 / signed link),
# never through this repo. Broad globs so a rename can't accidentally
# slip a binary into git history.
*.tar.gz
*.tgz
*.tar
*.zip
*.gz

# Generic Node / editor noise
node_modules/
.DS_Store
*.log
